# Copia este archivo a .env y rellena los valores. .env NUNCA se sube al repo.
# Genera la clave con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# --- Obligatorias en todos los entornos ---
SECRET_KEY=pon-aqui-tu-propia-clave-secreta-generada
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- Solo produccion (configurar en Easypanel > Environment, no en un .env) ---
# DATABASE_URL=postgres://usuario:password@nombre-servicio-db:5432/nombre_db
# CSRF_TRUSTED_ORIGINS=https://iabits.tech
# ADMIN_URL=una-ruta-secreta-para-el-admin/

# --- Limites de uso (opcional; los valores por defecto van entre parentesis) ---
# Proxies propios delante de gunicorn. Easypanel pone 1; subelo solo si anades
# otro delante (p. ej. Cloudflare). De el depende que la IP del visitante no se
# pueda falsificar: ver apps/common/http.py.
# TRUSTED_PROXY_DEPTH=1              (1)
# LEAD_THROTTLE_MAX=5                (5 envios del formulario por IP)
# LEAD_THROTTLE_WINDOW_MINUTES=60    (60 min de ventana)
# LOGIN_THROTTLE_MAX=5               (5 intentos de login fallidos por IP)
# LOGIN_THROTTLE_WINDOW_MINUTES=15   (15 min de ventana)
# CHAT_THROTTLE_MAX=20               (20 mensajes del chat por IP)
# CHAT_THROTTLE_WINDOW_MINUTES=60    (60 min de ventana)

# --- Webhook de n8n (opcional; vacio = los leads solo se guardan en la BD) ---
# La URL debe ser https salvo que apunte a localhost: el token y los datos del
# lead viajan en la peticion.
# N8N_WEBHOOK_URL=https://tu-n8n.easypanel.host/webhook/lead-landing
# N8N_WEBHOOK_TOKEN=un-token-largo-y-aleatorio
# N8N_WEBHOOK_TIMEOUT=10
# N8N_WEBHOOK_SOURCE=landing

# --- Chat con el agente de IA (opcional; vacio = el chat no se muestra) ---
# Mismas reglas de https que el webhook de leads y mismo N8N_WEBHOOK_TOKEN.
# N8N_CHAT_WEBHOOK_URL=https://tu-n8n.easypanel.host/webhook/chat-landing
# N8N_CHAT_TIMEOUT=25
