# Reglas de formato comunes a cualquier editor. https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{html,css,js,json,yml,yaml,md}]
indent_size = 2

[*.md]
# Dos espacios al final significan salto de línea en Markdown.
trim_trailing_whitespace = false
